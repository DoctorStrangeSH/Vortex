rules_version = '2';
// Assumed model: users/{uid} (uid, username), usernames/{name} (uid, username),
// chats/{id} (type, participants, createdBy; channels additionally have ownerId,
// admins, subscribers, subscriberCount), messages/{id} (senderId, text), typing/{uid}.
// Membership lists are capped at 100; all identities are Firebase Auth UIDs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(chat) {
      return signedIn() && request.auth.uid in chat.participants;
    }
    function chatMember(chatId) {
      return member(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }
    function validChat(data) {
      return data.keys().hasAll(['type', 'participants']) &&
        data.type in ['private', 'group', 'channel', 'secret'] &&
        (!('createdBy' in data) ||
         (data.createdBy is string && data.createdBy.size() > 0)) &&
        data.participants is list && data.participants.size() >= 1 &&
        data.participants.size() <= 100 &&
        (data.type != 'channel' || (
          data.keys().hasAll(['ownerId', 'admins', 'subscribers', 'subscriberCount']) &&
          data.ownerId == data.createdBy &&
          data.admins is list && data.admins.size() == 1 &&
          data.admins[0] == data.ownerId &&
          data.subscribers is list && data.subscribers == data.participants &&
          data.subscriberCount == data.subscribers.size()
        ));
    }
    function validChannelMembershipChange() {
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      let joining = !(uid in before.participants) &&
        uid in after.participants && uid in after.subscribers &&
        after.participants.size() == before.participants.size() + 1 &&
        after.subscribers.size() == before.subscribers.size() + 1 &&
        after.participants.hasAll(before.participants) &&
        after.subscribers.hasAll(before.subscribers);
      let leaving = uid in before.participants && uid in before.subscribers &&
        uid != before.ownerId &&
        !(uid in after.participants) && !(uid in after.subscribers) &&
        before.participants.size() == after.participants.size() + 1 &&
        before.subscribers.size() == after.subscribers.size() + 1 &&
        before.participants.hasAll(after.participants) &&
        before.subscribers.hasAll(after.subscribers);
      return signedIn() && before.type == 'channel' &&
        after.diff(before).affectedKeys().hasOnly([
          'participants', 'subscribers', 'subscriberCount'
        ]) &&
        after.subscriberCount == before.subscriberCount + (joining ? 1 : -1) &&
        (joining || leaving);
    }

    match /users/{userId} {
      // Profiles are searchable by signed-in users. Avoid storing private data here.
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId &&
        (request.resource.data.username == '' ||
         (request.resource.data.username is string &&
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId));
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      // A transaction creating a deterministic DM first reads a missing doc.
      // Read of an absent document reveals no contents; existing chats remain private.
      allow get: if (signedIn() && !exists(/databases/$(database)/documents/chats/$(chatId))) || member(resource.data);
      allow list: if member(resource.data);
      allow create: if signedIn() && validChat(request.resource.data) &&
        member(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if validChat(request.resource.data) && (
        (member(resource.data) &&
          (resource.data.type != 'channel' || request.auth.uid in resource.data.admins) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageTime', 'pinnedMessages'
          ])) || validChannelMembershipChange()
        );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId) &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' ||
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.admins) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 4096;
        allow update: if chatMember(chatId) && (
          (resource.data.senderId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'text', 'isEdited', 'editedAt', 'selfDestruct', 'destructAt'
           ])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'reactions'])
        );
        allow delete: if chatMember(chatId) && resource.data.senderId == request.auth.uid;
      }

      match /typing/{userId} {
        allow read: if chatMember(chatId);
        allow create, update, delete: if chatMember(chatId) && request.auth.uid == userId;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
