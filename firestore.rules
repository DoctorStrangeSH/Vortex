rules_version = '2';
// Message schema: senderId/text required; optional senderName, type, createdAt,
// attachment metadata, readBy, reactions, edit and expiry metadata.
// Chat schema: type/participants required; group and channel administrators
// originate with the creator and are not editable by ordinary members.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(chat) { return signedIn() && request.auth.uid in chat.participants; }
    function chatMember(chatId) { return member(get(/databases/$(database)/documents/chats/$(chatId)).data); }
    function validPublicProfile(data, uid) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
        data.keys().hasOnly(['uid','username','displayName','bio','isOnline','lastSeen','emojiStatus','customStatus','statusUpdatedAt']) &&
        data.uid == uid && data.username is string && data.username.size() <= 24 &&
        data.displayName is string && data.displayName.size() <= 80 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('customStatus' in data) || data.customStatus == null || (data.customStatus is string && data.customStatus.size() <= 100)) &&
        (!('emojiStatus' in data) || data.emojiStatus == null || (data.emojiStatus is string && data.emojiStatus.size() <= 16)) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('lastSeen' in data) || data.lastSeen is timestamp) &&
        (!('statusUpdatedAt' in data) || data.statusUpdatedAt == null || data.statusUpdatedAt is timestamp);
    }
    function validChat(data) {
      return data.keys().hasAll(['type','participants']) && data.type in ['private','group','channel','secret'] &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() > 0)) &&
        data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 100 &&
        (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (data.type != 'group' || (data.admins is list && data.admins.size() >= 1 &&
          data.admins.size() <= 10 && data.admins[0] == data.createdBy &&
          data.participants.hasAll(data.admins))) &&
        (data.type != 'channel' || (data.keys().hasAll(['ownerId','admins','subscribers','subscriberCount']) &&
          data.ownerId == data.createdBy && data.admins is list && data.admins.size() == 1 &&
          data.admins[0] == data.ownerId && data.subscribers is list && data.subscribers == data.participants &&
          data.subscriberCount == data.subscribers.size()));
    }
    function validChannelMembershipChange() {
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      let joining = !(uid in before.participants) && uid in after.participants && uid in after.subscribers &&
        after.participants.size() == before.participants.size() + 1 && after.subscribers.size() == before.subscribers.size() + 1 &&
        after.participants.hasAll(before.participants) && after.subscribers.hasAll(before.subscribers);
      let leaving = uid in before.participants && uid in before.subscribers && uid != before.ownerId &&
        !(uid in after.participants) && !(uid in after.subscribers) &&
        before.participants.size() == after.participants.size() + 1 && before.subscribers.size() == after.subscribers.size() + 1 &&
        before.participants.hasAll(after.participants) && before.subscribers.hasAll(after.subscribers);
      return signedIn() && before.type == 'channel' &&
        after.diff(before).affectedKeys().hasOnly(['participants','subscribers','subscriberCount']) &&
        after.subscriberCount == before.subscriberCount + (joining ? 1 : -1) && (joining || leaving);
    }
    function validGroupMemberChange() {
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      let admin = uid in before.admins;
      let addition = after.participants.size() == before.participants.size() + 1 &&
        after.participants.hasAll(before.participants) && admin;
      let removal = before.participants.size() == after.participants.size() + 1 &&
        before.participants.hasAll(after.participants) && after.participants.hasAll(before.admins) &&
        (admin || (uid in before.participants && !(uid in after.participants)));
      return signedIn() && before.type == 'group' &&
        after.diff(before).affectedKeys().hasOnly(['participants']) && (addition || removal);
    }
    function validGroupAdminChange() {
      let before = resource.data;
      let after = request.resource.data;
      let promotion = after.admins.size() == before.admins.size() + 1 &&
        after.admins.hasAll(before.admins) && after.participants.hasAll(after.admins);
      let demotion = before.admins.size() == after.admins.size() + 1 &&
        before.admins.hasAll(after.admins) && after.admins[0] == before.createdBy;
      return signedIn() && before.type == 'group' && request.auth.uid == before.createdBy &&
        after.diff(before).affectedKeys().hasOnly(['admins']) && (promotion || demotion);
    }
    function validReadReceiptChange() {
      let before = resource.data.get('readBy', []);
      let after = request.resource.data.get('readBy', []);
      return before is list && after is list && after.size() == before.size() + 1 &&
        after.hasAll(before) && request.auth.uid in after && !(request.auth.uid in before);
    }
    function validReactionForKey(before, after, key) {
      let oldList = before.get(key, []);
      let newList = after.get(key, []);
      return oldList is list && newList is list &&
        ((newList.size() == oldList.size() + 1 && newList.hasAll(oldList) &&
          request.auth.uid in newList && !(request.auth.uid in oldList)) ||
         (oldList.size() == newList.size() + 1 && oldList.hasAll(newList) &&
          request.auth.uid in oldList && !(request.auth.uid in newList)));
    }
    function validReactionChange() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      let changed = after.diff(before).affectedKeys();
      return before is map && after is map && changed.size() == 1 && (
        (changed.hasOnly(['👍']) && validReactionForKey(before, after, '👍')) ||
        (changed.hasOnly(['❤️']) && validReactionForKey(before, after, '❤️')) ||
        (changed.hasOnly(['😂']) && validReactionForKey(before, after, '😂')) ||
        (changed.hasOnly(['😮']) && validReactionForKey(before, after, '😮')) ||
        (changed.hasOnly(['😢']) && validReactionForKey(before, after, '😢')) ||
        (changed.hasOnly(['😡']) && validReactionForKey(before, after, '😡'))
      );
    }
    function validMessage(data, chatId) {
      return data.keys().hasAll(['senderId', 'text']) &&
        data.keys().hasOnly(['senderId','senderName','createdAt','type','text','readBy',
          'reactions','fileData','fileName','fileSize','storagePath','isEdited',
          'editedAt','selfDestruct','destructAt']) &&
        data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
        data.text is string && data.text.size() <= 4096 &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('type' in data) || data.type in ['text','image','video','voice','audio','file']) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255)) &&
        (!('fileData' in data) || (data.fileData is string && data.fileData.size() <= 500000)) &&
        (!('fileSize' in data) || (data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 26214400)) &&
        (!('storagePath' in data) || (data.storagePath is string &&
          data.storagePath.matches('^chats/' + chatId + '/media/' + data.senderId + '/[^/]+$'))) &&
        (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 100)) &&
        (!('reactions' in data) || (data.reactions is map && data.reactions.size() <= 6 &&
          data.reactions.keys().hasOnly(['👍','❤️','😂','😮','😢','😡']))) &&
        (!('isEdited' in data) || data.isEdited is bool) &&
        (!('editedAt' in data) || data.editedAt is timestamp) &&
        (!('selfDestruct' in data) || (data.selfDestruct is int && data.selfDestruct >= 1 && data.selfDestruct <= 604800)) &&
        (!('destructAt' in data) || data.destructAt is timestamp);
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId &&
        (request.resource.data.username == '' || (request.resource.data.username is string &&
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId));
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && validPublicProfile(request.resource.data,userId) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.username == request.resource.data.username;
      allow update: if signedIn() && request.auth.uid == userId && validPublicProfile(request.resource.data,userId) &&
        request.resource.data.username == resource.data.username;
      allow delete: if false;
    }
    match /usernames/{username} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/usernames/$(username)) ||
        !('email' in resource.data) || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && !('email' in resource.data);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if signedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid','username']) &&
        request.resource.data.uid == resource.data.uid && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow get: if (signedIn() && !exists(/databases/$(database)/documents/chats/$(chatId))) || member(resource.data);
      allow list: if member(resource.data);
      allow create: if signedIn() && validChat(request.resource.data) && member(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        (request.resource.data.type != 'group' || request.resource.data.admins == [request.auth.uid]);
      allow update: if validChat(request.resource.data) && (
        (member(resource.data) && (resource.data.type != 'channel' || request.auth.uid in resource.data.admins) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastMessageTime','pinnedMessages'])) ||
        validChannelMembershipChange() || validGroupMemberChange() || validGroupAdminChange());
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId) && validMessage(request.resource.data, chatId) &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' ||
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.admins) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 4096 &&
          (!('readBy' in request.resource.data) || request.resource.data.readBy == []) &&
          !('reactions' in request.resource.data);
        allow update: if chatMember(chatId) && validMessage(request.resource.data, chatId) && (
          (resource.data.senderId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','isEdited','editedAt','selfDestruct','destructAt'])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) && validReadReceiptChange()) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) && validReactionChange()));
        allow delete: if chatMember(chatId) && resource.data.senderId == request.auth.uid;
      }
      match /typing/{userId} {
        allow read: if chatMember(chatId);
        allow create, update, delete: if chatMember(chatId) && request.auth.uid == userId;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
