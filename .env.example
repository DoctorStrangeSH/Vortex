# Copy to .env.staging.local and replace EVERY value with a separate Firebase test project.
VITE_APP_ENV=staging
VITE_FIREBASE_API_KEY=your-staging-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-staging-project
VITE_FIREBASE_STORAGE_BUCKET=your-staging-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-staging-sender-id
VITE_FIREBASE_APP_ID=your-staging-app-id
# Enable ONLY after test rules and CORS are configured.
VITE_USE_FIREBASE_STORAGE=false
