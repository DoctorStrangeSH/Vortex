rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(chatId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    // The Storage object ID is the Firestore message ID. A sender may remove
    // their object only after its message has been deleted, so live messages
    // cannot be silently turned into broken attachments. This also lets the
    // original owner clean up an orphan after leaving the chat.
    function attachmentMessageMissing(chatId, fileId) {
      return !firestore.exists(/databases/(default)/documents/chats/$(chatId)/messages/$(fileId));
    }

    match /chats/{chatId}/media/{userId}/{fileId} {
      allow read: if member(chatId);
      allow create: if resource == null && member(chatId) && request.auth.uid == userId &&
        request.resource.size > 0 && request.resource.size <= 25 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.size() <= 128 &&
        request.resource.contentType.matches('^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$') &&
        !(request.resource.contentType in ['text/html','image/svg+xml','application/javascript','text/javascript','application/x-javascript','application/xhtml+xml','application/xml','text/xml']) &&
        fileId.matches('^[A-Za-z0-9_-]{1,128}$') &&
        userId.matches('^[A-Za-z0-9_-]{1,128}$');
      allow delete: if request.auth != null && request.auth.uid == userId && attachmentMessageMissing(chatId, fileId);
      allow update: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
